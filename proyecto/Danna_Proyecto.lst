                                ; Limitar a 254 (evitar $FF = -1)
28da c1 ff                      Cmpb #$FF
28dc 26 02                      Bne TimerFin_OK
28de c6 fe                      Ldab #$FE            ; Usar 254 si es 255
                        
28e0                    TimerFin_OK:
