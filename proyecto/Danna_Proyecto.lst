                        ;*******************************************************************************
                        ;                         TAREA CONVERSION BCD BIN
                        ;*******************************************************************************
                        
2883 b7 01              BCD_BIN         Tfr A,B                 ;Se copia el valor BCD en el acumulador B
                        
2885 84 0f                              Anda #$0F               ;Se obtiene el n mero de las unidades
2887 7a 10 29                           Staa BCD                ;Se carga el n mero de las unidades en BCD
                        
288a 54                                 Lsrb                    ;Se desplaza 4 posiciones el valor de las decenas
288b 54                                 Lsrb
288c 54                                 Lsrb
288d 54                                 Lsrb
                        
288e 86 0a                              Ldaa #10                ;Se multiplica por 10
2890 12                                 Mul
                        
2891 fb 10 29                           Addb BCD                ;Se le suma a las unidades, el valor de las decenas multiplicado por 10
2894 7b 10 29                           Stab BCD                ;Se guarda el resultado en BCD
2897 3d                                 Rts
                        
                        ;*******************************************************************************
                        ;                               SUBRUTINA CALCULA
                        ;*******************************************************************************
                        ; Descripción: Calcula velocidad y timers basados en tiempo entre sensores
                        ; Entradas: TimerCal (debe estar corriendo desde S1)
                        ; Salidas: DeltaT, Velocidad, TimerIniPant, TimerFinPant
                        ; Fórmulas:
                        ;   DeltaT = tTimerCal - TimerCal (en unidades de 100ms)
                        ;   Velocidad = (DeltaS * 36) / DeltaT (en km/h)
                        ;   TimerIniPant = (DeltaT * DeltaM) / DeltaS (en 100ms)
                        ;   TimerFinPant = (DeltaT * DeltaP) / DeltaS (en 100ms)
                        ;*******************************************************************************
                        
2898                    Calcula:
