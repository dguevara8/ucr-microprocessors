                        ;                          DESPACHADOR DE TAREAS
                        ;******************************************************************************
208c                    Despachador_Tareas:
208c 16 21 fc                           Jsr Decre_TablaTimers
208f 16 20 97                           Jsr Tarea_ATD
2092 16 20 eb                           Jsr Tarea_Terminal
2095 20 f5                              Bra Despachador_Tareas
                        
                        ;******************************************************************************
                        ;                               TAREA ATD
                        ;******************************************************************************
2097                    Tarea_ATD:
2097 fe 10 04                           Ldx Estado_Pres_ATD
209a 15 00                              Jsr 0,x
209c 3d                                 Rts
                        
                        ;=========================== TAREA ATD ESTADO 1 ================================
209d                    ATD_Estado1:
209d 18 0b 05 15 0c                     Movb #tTimerATD,TimerATD
20a2 18 03 20 a9 10 04                  Movw #ATD_Estado2,Estado_Pres_ATD
20a8 3d                                 Rts
                        
                        ;=========================== TAREA ATD ESTADO 2 ================================
20a9                    ATD_Estado2:
20a9 f7 15 0c                           Tst TimerATD
20ac 26 0b                              Bne Fin_ATD_Estado2
20ae 18 0b 87 00 85                     Movb #$87,ATD0CTL5
20b3 18 03 20 ba 10 04                  Movw #ATD_Estado3,Estado_Pres_ATD
20b9                    Fin_ATD_Estado2:
20b9 3d                                 Rts
                        
                        ;=========================== TAREA ATD ESTADO 3 ================================
20ba                    ATD_Estado3:
20ba 4f 86 80 2c                        Brclr ATD0STAT0,SCF,Fin_ATD_Estado3
20be 16 21 bc                           Jsr Calcula
                        
20c1 b6 10 0a                           Ldaa Volumen
20c4 81 0e                              Cmpa #14
20c6 22 09                              Bhi Verificar_Alarma_Off
20c8 1c 10 12 01                        Bset Flags,Flag_Alarma
20cc 4c 08 04                           Bset PortRele,MaskRele
20cf 20 13                              Bra Reiniciar_ATD
                        
20d1                    Verificar_Alarma_Off:
20d1 81 1c                              Cmpa #28
20d3 23 04                              Bls Verificar_Vaciado
20d5 1d 10 12 01                        Bclr Flags,Flag_Alarma
                        
20d9                    Verificar_Vaciado:
20d9 81 53                              Cmpa #83
20db 23 07                              Bls Reiniciar_ATD
20dd 1c 10 12 02                        Bset Flags,Flag_Vaciado
20e1 4d 08 04                           Bclr PortRele,MaskRele
                        
20e4                    Reiniciar_ATD:
20e4 18 03 20 9d 10 04                  Movw #ATD_Estado1,Estado_Pres_ATD
                        
20ea                    Fin_ATD_Estado3:
20ea 3d                                 Rts
                        
