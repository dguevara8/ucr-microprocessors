                        ;===============================================================================
2000                                    Org $2000
                        ; Configuracion del SCI
2000 18 03 00 27 00 d0                  Movw #39,SC1BDH
2006 18 0b 00 00 d2                     Movb #$00,SC1CR1
200b 18 0b 0c 00 d3                     Movb #$0C,SC1CR2
                        
2010 96 d4                              Ldaa SC1SR1
2012 18 0b 00 00 d7                     Movb #$00,SC1DRL
                        
                        ; Configuracion del ATD
2017 18 0b c0 00 82                     Movb #$C0,ATD0CTL2
201c 86 a0                              Ldaa #160
201e 04 30 fd           Espere_ATD:     Dbne a,Espere_ATD
2021 18 0b 20 00 83                     Movb #$20,ATD0CTL3
2026 18 0b 10 00 84                     Movb #$10,ATD0CTL4
                        
                        ; Configuracion de puertos
202b 4c 09 04                           Bset DDRE,$04
202e 1c 02 42 20                        Bset DDRT,$20
2032 4d 08 04                           Bclr PORTE,$04
2035 1d 02 40 20                        Bclr PTT,$20
                        
                        ; Configuracion del Modulo de Contador
2039 4c 66 c7                           Bset MCCTL,$C7
203c 18 03 00 1e 00 76                  Movw #Recarga_TC,MCCNT
                        
                        ; Inicializacion de timers
2042 18 03 00 32 15 00                  Movw #tTimer1mS,Timer1mS
2048 18 03 01 f4 15 02                  Movw #tTimer10mS,Timer10mS
204e 18 03 13 88 15 04                  Movw #tTimer100mS,Timer100mS
2054 18 03 c3 50 15 06                  Movw #tTimer1S,Timer1S
                        
                        ; Envio mensaje inicial
205a 18 0b 00 10 00                     Movb #MSG1,Puntero_Serial
205f 4c d3 08                           Bset SC1CR2,$08
                        
2062                    Transmitir_Inicio:
2062 4f d4 80 fc                        Brclr SC1SR1,$80,Transmitir_Inicio
2066 96 d4                              Ldaa SC1SR1
2068 fe 10 00                           Ldx Puntero_Serial
206b a6 30                              Ldaa 1,x+
206d 81 ff                              Cmpa #EOM
206f 27 07                              Beq Finalizar_Transmision
2071 5a d7                              Staa SC1DRL
2073 7e 10 00                           Stx Puntero_Serial
2076 20 ea                              Bra Transmitir_Inicio
                        
2078                    Finalizar_Transmision:
2078 18 03 20 f1 10 0c                  Movw #Terminal_Estado1,Estado_Terminal
                        
                        ;*******************************************************************************
                        ;                          Programa Principal
                        ;*******************************************************************************
207e cf 3b ff                           Lds #$3BFF
2081 10 ef                              Cli
2083 79 10 12                           Clr Flags
2086 18 03 20 9d 10 04                  Movw #ATD_Estado1,Estado_Pres_ATD
                        
